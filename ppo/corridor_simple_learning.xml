<?xml version='1.0' encoding='utf-8'?>
<mujoco model="corridor_simple_learning">
  <compiler angle="degree" autolimits="true" />
  <option timestep="0.005" gravity="0 0 -9.81" />
  <size njmax="4000" nconmax="1000" />
<asset>
    <texture name="tex_grid" type="2d" builtin="checker" rgb1="0.1 0.1 0.1" rgb2="0.15 0.15 0.15" width="300" height="300" mark="edge" markrgb="0.8 0.8 0.8" />
    
    <texture name="tex_wall" type="2d" builtin="checker" rgb1="0.5 0.5 0.5" rgb2="0.55 0.55 0.55" width="300" height="300" />

    <material name="mat_floor" texture="tex_grid" texrepeat="2 2" specular="0.1" shininess="0.1" />
              
    <material name="mat_wall" texture="tex_wall" texrepeat="1 1" rgba="0.5 0.5 0.5 0" specular="0.3" shininess="0.3" />
              
    <material name="mat_bump" texture="tex_wall" rgba="0.5 0.5 0.5 1" specular="0.3" shininess="0.3" />
    
    <material name="mat_bridge" texture="tex_wall" rgba="0.2 0.8 0.2 1" specular="0.3" shininess="0.3" />
  </asset>
  <worldbody>
<light name="key_light" pos="4 4 4" dir="-1 -1 -1" directional="true" diffuse="1.1 1.1 1.1" specular="0.4 0.4 0.4" castshadow="true" />

<light name="fill_light" pos="-6 4 2" dir="1 -0.5 -1" directional="true" ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6" specular="0.2 0.2 0.2" castshadow="false" />

    <!-- Walls -->
    <geom name="wall_left" type="box" size="25.000 0.025 4.000" pos="25.000 -1.525 4.000" material="mat_wall" />
    <geom name="wall_right" type="box" size="25.000 0.025 4.000" pos="25.000 1.525 4.000" material="mat_wall" />
    
    <!-- CURRICULUM LEARNING: Start with mostly solid floor, few gaps -->
    
    <!-- Solid floor sections (safe areas) -->
    <geom name="floor_start" type="box" size="2.0 1.5 0.025" pos="2.0 0 0.025" material="mat_floor" />
    <geom name="floor_1" type="box" size="1.0 1.5 0.025" pos="6.0 0 0.025" material="mat_floor" />
    <geom name="floor_2" type="box" size="1.0 1.5 0.025" pos="10.0 0 0.025" material="mat_floor" />
    <geom name="floor_3" type="box" size="1.0 1.5 0.025" pos="14.0 0 0.025" material="mat_floor" />
    <geom name="floor_4" type="box" size="1.0 1.5 0.025" pos="18.0 0 0.025" material="mat_floor" />
    <geom name="floor_5" type="box" size="1.0 1.5 0.025" pos="22.0 0 0.025" material="mat_floor" />
    <geom name="floor_end" type="box" size="2.0 1.5 0.025" pos="26.0 0 0.025" material="mat_floor" />
    
    <!-- First gap with WIDE bridge (easy) -->
    <geom name="bridge_1" type="box" size="1.0 0.8 0.025" pos="8.0 0 0.15" material="mat_bridge" />
    
    <!-- Second gap with medium bridge -->
    <geom name="bridge_2" type="box" size="1.0 0.6 0.025" pos="12.0 0 0.15" material="mat_bridge" />
    
    <!-- Third gap with narrow bridge -->
    <geom name="bridge_3" type="box" size="1.0 0.4 0.025" pos="16.0 0 0.15" material="mat_bridge" />
    
    <!-- Fourth gap with side bridge (teaches lateral movement) -->
    <geom name="bridge_4" type="box" size="1.0 0.4 0.025" pos="20.0 0.8 0.15" material="mat_bridge" />
    
    <!-- Final gap with narrow side bridge (hardest) -->
    <geom name="bridge_5" type="box" size="1.0 0.3 0.025" pos="24.0 -0.8 0.15" material="mat_bridge" />
    
  </worldbody>
</mujoco>