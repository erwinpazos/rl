<mujoco model="simple_robot_mjx">
  <compiler angle="degree" autolimits="true"/>
  
  <option timestep="0.01" gravity="0 0 -9.81"/>
  
  <default>
    <geom friction="1.2 0.01 0.2"/>
  </default>

  <asset>
    <material name="mat_chassis" rgba="0.8 0.2 0.2 1"/>
    <material name="mat_wheel" rgba="0.1 0.1 0.1 1"/>
    <material name="mat_floor" rgba="0.8 0.8 0.8 1"/>
  </asset>

  <worldbody>
    <!-- Simple floor plane (MJX compatible) -->
    <geom name="floor" type="plane" size="50 1.5 0.1" pos="50 0 0" material="mat_floor"/>
    
    <!-- Robot with CAPSULE wheels instead of cylinders (MJX compatible) -->
    <body name="robot" pos="2 0 0.3">
      <joint name="root" type="free" damping="0.1"/>
      <geom name="chassis" type="box" size="0.40 0.30 0.10" material="mat_chassis" mass="15"/>

      <!-- Front-left wheel: CAPSULE instead of cylinder -->
      <body name="wheel_fl" pos="0.35 0.30 -0.10">
        <joint name="hinge_fl" type="hinge" axis="0 1 0" damping="0.2" limited="false"/>
        <geom name="geom_fl" type="capsule" size="0.03 0.2" material="mat_wheel" mass="1.0"/>
      </body>

      <!-- Front-right wheel -->
      <body name="wheel_fr" pos="0.35 -0.30 -0.10">
        <joint name="hinge_fr" type="hinge" axis="0 1 0" damping="0.2" limited="false"/>
        <geom name="geom_fr" type="capsule" size="0.03 0.2" material="mat_wheel" mass="1.0"/>
      </body>

      <!-- Rear-left wheel -->
      <body name="wheel_rl" pos="-0.35 0.30 -0.10">
        <joint name="hinge_rl" type="hinge" axis="0 1 0" damping="0.2" limited="false"/>
        <geom name="geom_rl" type="capsule" size="0.03 0.2" material="mat_wheel" mass="1.0"/>
      </body>

      <!-- Rear-right wheel -->
      <body name="wheel_rr" pos="-0.35 -0.30 -0.10">
        <joint name="hinge_rr" type="hinge" axis="0 1 0" damping="0.2" limited="false"/>
        <geom name="geom_rr" type="capsule" size="0.03 0.2" material="mat_wheel" mass="1.0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <velocity name="motor_fl" joint="hinge_fl" kv="2" ctrllimited="true" ctrlrange="-100 100"/>
    <velocity name="motor_fr" joint="hinge_fr" kv="2" ctrllimited="true" ctrlrange="-100 100"/>
    <velocity name="motor_rl" joint="hinge_rl" kv="2" ctrllimited="true" ctrlrange="-100 100"/>
    <velocity name="motor_rr" joint="hinge_rr" kv="2" ctrllimited="true" ctrlrange="-100 100"/>
  </actuator>
</mujoco>
