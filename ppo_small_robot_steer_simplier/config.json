    "track_width": 0.4,
    "wheel_radius": 0.15,
    "robot_length": 0.80,
    "robot_width": 0.46
  },
  "vision": {
    "vision_behind": 0.5,
    "vision_front": 5.2,
    "vision_width": 3.0,
    "cell_size": 0.1,
    "grid_rows": 57,
    "grid_cols": 30,
    "robot_row_in_grid": 5
  },
  "history": {
    "history_interval": 15,
    "history_length": 4
  },
  "corridor": {
    "corridor_length": 100.0,
    "corridor_width": 3.0,
    "cell_size_generation": 0.5
  }
