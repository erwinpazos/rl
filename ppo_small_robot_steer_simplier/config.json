{
  "training": {
    "total_timesteps": 8000000,
    "num_envs": 32,
    "num_steps": 1024,
    "num_minibatches": 32,
    "update_epochs": 10,
    "seed": 1
  },
  "ppo": {
    "lr": 0.0005,
    "gamma": 0.995,
    "gae_lambda": 0.98,
    "clip_coef": 0.2,
    "ent_coef": 0.05,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },
  "optimizer": {
    "eps": 1e-5
  },
  "environment": {
    "max_steps": 3000,
    "use_random_corridor": true
  },
  "network": {
    "robot_state_dim": 7,
    "history_dim": 24,
    "grid_dim": 3420,
    "robot_net_hidden": [32],
    "history_net_hidden": [64, 32],
    "cnn_channels": [32, 64],
    "cnn_kernel_size": 3,
    "cnn_stride": 2,
    "backbone_hidden": [64]
  },
  "logging": {
    "log_interval": 2,
